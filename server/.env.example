# Server Port
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas)
# Example for local MongoDB: mongodb://127.0.0.1:27017/usermanagement
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/usermanagement?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/usermanagement

# Node Environment (development | production)
NODE_ENV=development
